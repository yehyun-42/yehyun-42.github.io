FLASK_APP=apps.app:create_app("local")
FLASK_ENV=development

FLASK_DEBUG=1

MAIL_SERVER=smtp.naver.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USERNAME=your_naver_mail@naver.com
MAIL_PASSWORD=your_naver_mail_password

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_RUN_EXTRA_ARGS=--with-threads
